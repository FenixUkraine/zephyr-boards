if BOARD_FXA500_03

config BOARD
	default "fxa500_03"


# Здається з esp-hosted нічого не вийде, бо для нього треба SPI або SDIO
if NETWORKING

config WIFI_ESP_HOSTED
	default y

endif # NETWORKING


if MODEM_CELLULAR

config MODEM_CELLULAR_PREINIT_PRIORITY
	int "Cellular modem driver initialization priority"
	default 69
	range 0 99
	help
	  Driver pre-initialization priority for cellular modem drivers.
	  Defaults to less than POST_KERNEL/MODEM_CELLULAR_INIT_PRIORITY.
	  But greater than GPIO/Driver.

endif # MODEM_CELLULAR

if GNSS

config BOARD_FXA500_03_GPS_POWER_INIT_PRIORITY
	int "GPS modem driver initialization priority"
	default 79
	range 0 99
	help
	  Driver pre-initialization priority for gnss modem drivers.
	  Defaults to less than POST_KERNEL/GNSS_INIT_PRIORITY (80).
	  But greater than GPIO/Driver.

endif # GNSS

endif
